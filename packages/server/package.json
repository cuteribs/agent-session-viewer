{
  "name": "@cuteribs/agent-session-viewer",
  "version": "0.6.2",
  "description": "Web application for analyzing Claude Code and Copilot CLI sessions",
  "repository": {
    "type": "git",
    "url": "https://github.com/cuteribs/agent-session-viewer"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agent-session-viewer": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build:client && npm run build:server && npm run build:public",
    "build:client": "npm run --prefix ../client build",
    "build:server": "tsup",
    "build:public": "mkdir -p dist/public && cp -r ../client/dist/* dist/public/",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "chokidar": "^3.5.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "open": "^10.0.3",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/ws": "^8.5.10",
    "shared": "file:../shared",
    "tsup": "8.5.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
