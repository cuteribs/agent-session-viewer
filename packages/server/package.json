{
  "name": "@cuteribs/agent-session-viewer",
  "version": "0.8.0",
  "description": "Web application for analyzing Claude Code and Copilot CLI sessions",
  "repository": {
    "type": "git",
    "url": "https://github.com/cuteribs/agent-session-viewer"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agent-session-viewer": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build:client && npm run build:server && npm run build:public",
    "build:client": "npm run --prefix ../client build",
    "build:server": "tsdown",
    "build:public": "copyfiles -u 3 ../client/dist/* ../client/dist/**/* dist/public",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "test": "tsx --test src/parsers/cost.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "open": "^10.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "shared": "file:../shared",
    "copyfiles": "^2.4.1",
    "tsdown": "^0.22.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
