{
  "manifest_version": 3,
  "name": "Agent Session Viewer",
  "version": "0.7.0",
  "description": "View and analyze AI agent sessions (Claude Code, Copilot, Codex, OpenCode, VS Code).",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "64": "icon64.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Open Agent Session Viewer",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "64": "icon64.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:*/*",
    "ws://localhost:*/*",
    "https://*/*",
    "wss://*/*"
  ]
}
