{
  "manifest_version": 3,
  "name": "Agent Session Viewer",
  "version": "1.0.0",
  "description": "Analyze and visualize AI agent sessions from Claude Code, Copilot CLI, Codex, OpenCode, and VS Code Copilot Chat.",
  "action": {
    "default_title": "Agent Session Viewer"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "permissions": [],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
