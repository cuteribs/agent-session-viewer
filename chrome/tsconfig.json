{
  "extends": "../client/tsconfig.json",
  "compilerOptions": {
    "types": ["chrome"],
    "paths": {
      "@/*": ["./src/*", "../client/src/*"],
      "shared/*": ["../shared/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "../client/src/**/*.ts",
    "../client/src/**/*.tsx",
    "../client/src/**/*.vue"
  ]
}
